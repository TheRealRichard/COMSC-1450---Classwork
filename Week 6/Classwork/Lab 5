## Lab 5-1

n = 0

def countdown(n):
    if n ==0:
        print("Liftoff")
    else:
        print(n)
        countdown(n-1)
    

countdown(10) 

## Lab 5-2

def print_range(start,stop):
    if start == stop:
        print("25")
        print("Done")
    else:
        print(start)
        print_range(start + 1, stop)

print_range(1,25)
