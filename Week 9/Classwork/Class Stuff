import tkinter as tk

def welcome():
    l3.config(text = "Welcome " + e1.get() + e2.get())

root = tk.Tk()

root.title("Greetings")
root.geometry("400x500")
root.config(bg = "blue")

l1 = tk.Label(root, text = "First Name:", bg = "yellow", fg = "green")
l1.grid(row = 0, column = 0, padx = 20, pady = 20)

e1 = tk.Entry(root)
e1.grid(row = 0, column = 1, padx = 20, pady = 20)

l2 = tk.Label(root, text = "Last Name:", bg = "yellow", fg = "green")
l2.grid(row = 1, column = 0, padx = 20, pady = 20)

e2 = tk.Entry(root)
e2.grid(row = 1, column = 1, padx = 20, pady = 20)

b = tk.Button(root, text = "Submit", command = welcome)
b.grid(row = 2, column = 0, padx = 20, pady = 20)

l3 = tk.Label(root)
l3.grid(row = 3, column = 1, padx = 20, pady = 20)

root.mainloop()
